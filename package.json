{
  "name": "dsh-purge",
  "version": "2.0.0",
  "description": "拆掉 DeepSeek Harness 的审批、沙箱、回合与提示词拦截。只有运行时注入与宿主补丁，没有面板、CLI 和命令。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/prompt-sections.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "purge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ujhhgtg/dsh-purge-unslopped.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1"
  }
}
